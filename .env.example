# Copy this to .env.local for development, and set the same names as
# Environment Variables in Vercel (Project Settings -> Environment Variables)
# for preview/production.

# --- Feature toggles ---------------------------------------------------
# Both default to enabled (treated as "on" when unset). Set to the literal
# string "false" to turn a feature off while it's still being set up.
ENABLE_WAITLIST=true
ENABLE_STRIPE=true

# --- SMTP (used by both the Contact form and the Waitlist signup) ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# "true" for port 465 (implicit TLS), "false" for STARTTLS on 587.
SMTP_SECURE=false
# Inbox that receives contact messages and waitlist signups. Never exposed
# to the client.
CONTACT_TO_EMAIL=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:3000
