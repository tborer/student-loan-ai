# ============================================================================
# Student Loan Repayment Analyzer — Vercel Environment Variables Template
# 
# Instructions:
# 1. Copy this file to .env.local (DO NOT commit .env.local to git)
# 2. Create these variables in your Vercel project dashboard > Settings > Environment Variables
# 3. Redeploy after adding environment variables
# ============================================================================

# ============================================================================
# STRIPE API CREDENTIALS (Required for Payment Processing)
# ============================================================================

# Stripe Secret Key: Get from https://dashboard.stripe.com/test/apikeys
# Choose "Expand" -> "Live mode" when ready for production
STRIPE_SECRET_KEY=sk_test_51ABC123EXAMPLE...  

# Stripe Webhook Signing Secret: 
# 1. In Stripe Dashboard, navigate to Developers > Webhooks
# 2. Select your endpoint (your Vercel URL)
# 3. Click "add sign endpoint" and copy the signing secret
STRIPE_WEBHOOK_SECRET=whsec_1ABC123EXAMPLE...  

# ============================================================================
# APPLICATION SETTINGS (Optional but Recommended)
# ============================================================================

# Your deployment domain (e.g., student-loan-ai.vercel.app or custom domain)
CLIENT_URL=https://your-app-name.vercel.app

# Stripe Price ID: Create in Stripe Dashboard > Products > Create Product > Create Price
# Set price for your analysis report (currently $9-$19 as per spec)
STRIPE_PRICE_ID=price_1ABC123EXAMPLE...  

# Magic Link Expiry Window (in hours): Default 7 days (168 hours) per spec
MAGIC_LINK_EXPIRY_HOURS=168

# ============================================================================
# ANALYSIS ENGINE CONFIGURATION (Optional - Client-Side First)
# ============================================================================

# Base currency for Stripe charges (default: USD)
STRIPE_CURRENCY=usd

# Enable analytics tracking? Set to true when ready (v1 currently no PII analytics)
ENABLE_ANALYTICS=false

# ============================================================================
# SECURITY & COMPIANCE (Production Required)
# ============================================================================

# Bot protection service (Cloudflare recommended, optional):
# API_KEY=<your-cloudflare-api-key>  # Only if using Cloudflare API

# Rate limiting configuration:
RATE_LIMIT_REQUESTS_PER_MINUTE=60  # Prevent abuse on analysis endpoint

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 
# After setting these variables in Vercel Dashboard:
# 1. Go to project settings > Environment Variables
# 2. Click "New Variable" for each above
# 3. Set values (you can use test keys initially)
# 4. Click "Add" then "Deploy" to redeploy
# 
# To view current env vars in Vercel CLI: vercel env pull
# To add variables via CLI: vercel env add STRIPE_SECRET_KEY sk_test_... --environment=development
# ============================================================================